{
  "name": "acg-monopoly",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "tsc -p tsconfig.json && npm --prefix client run build",
    "start": "node build/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix client run typecheck",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.10",
    "@colyseus/schema": "^5.0.26",
    "@colyseus/ws-transport": "^0.18.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
